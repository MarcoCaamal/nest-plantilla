# Local-only values for docker-compose.dev.yml. Replace before any public deployment.
NODE_ENV=development
PORT=3005
SERVICE_NAME=nest-plantilla
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nest_plantilla
JWT_ACCESS_SECRET=local-only-change-this-secret-before-deploying-12345
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
RESEND_API_KEY=
MAIL_FROM=system@example.test
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1027
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
CORS_ORIGINS=http://localhost:4200,http://localhost:3005
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=LocalDev_ChangeBeforeUse_123456!
OPENOBSERVE_USERNAME=dev@local.test
OPENOBSERVE_PASSWORD=LocalDevPassword-123!
